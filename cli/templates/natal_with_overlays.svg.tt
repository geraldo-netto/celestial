<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 1100" width="900" height="1100">
  <rect width="900" height="1100" fill="{{ vars.bg_color }}"/>

  <!-- Title with computed JD precision -->
  <text x="450" y="36" text-anchor="middle" font-size="22" font-weight="600"
        font-family="Georgia,serif" fill="{{ vars.text_color }}">Natal Chart with Calendar Overlays</text>
  <text x="450" y="56" text-anchor="middle" font-size="11"
        font-family="system-ui,sans-serif" fill="{{ vars.ring_color }}" opacity=".75">
    {{ date }}  ·  JD {{ jd | round(3) }}  ·  Asc {{ asc | round(2) }}°
  </text>

  <!-- Wheel sign spokes -->
  {% for s in signs %}
  <line x1="{{ s.spoke_x1 }}" y1="{{ s.spoke_y1 }}" x2="{{ s.spoke_x2 }}" y2="{{ s.spoke_y2 }}"
        stroke="{{ vars.ring_color }}" stroke-width=".6" opacity=".4"/>
  <text x="{{ s.glyph_x }}" y="{{ s.glyph_y }}" text-anchor="middle" dominant-baseline="central"
        font-size="13" font-family="serif" fill="{{ vars.ring_color }}">{{ s.glyph }}</text>
  {% endfor %}

  <!-- Planet glyphs with retrograde indicator (math: planet_color OR retro_color) -->
  {% for p in planets %}
  <text x="{{ p.x }}" y="{{ p.y }}" text-anchor="middle" dominant-baseline="central"
        font-size="15" font-family="serif"
        fill="{% if p.retrograde %}{{ vars.retro_color }}{% else %}{{ vars.planet_color }}{% endif %}">{{ p.glyph }}</text>
  {% endfor %}

  <!-- OMER OVERLAY (renders only if calendar omer was requested) -->
  {% if omer.today %}
  <g transform="translate(450, 870)">
    <rect x="-220" y="0" width="440" height="56" rx="6"
          fill="{% if omer.today.is_lag_baomer %}{{ vars.lag_color }}{% else %}{{ vars.text_color }}{% endif %}"
          fill-opacity="{% if omer.today.is_lag_baomer %}0.18{% else %}0.05{% endif %}"
          stroke="{{ vars.ring_color }}" stroke-width=".5"/>
    <text x="0" y="20" text-anchor="middle" font-size="11" font-family="system-ui,sans-serif"
          fill="{{ vars.ring_color }}">Sefirat HaOmer · Year {{ omer.hebrew_year }} · Day {{ omer.today.day }} of 49</text>
    <text x="0" y="40" text-anchor="middle" font-size="14" font-weight="600" font-family="Georgia,serif"
          fill="{{ vars.text_color }}">
      {{ omer.today.day_sefirah }} of {{ omer.today.week_sefirah }}
      {% if omer.today.is_lag_baomer %} ★ Lag Ba'Omer{% endif %}
    </text>
  </g>
  {% endif %}

  <!-- SABBATS OVERLAY — math: y = 965 + index * 14, no precomputed list_y needed -->
  {% if sabbats %}
  <text x="120" y="945" font-size="11" font-weight="600" font-family="system-ui,sans-serif" fill="{{ vars.ring_color }}">
    Wheel of the Year · {{ sabbats.year }}
  </text>
  {% for sb in sabbats.sabbats %}
  <text x="120" y="{{ 965 + loop.index0 * 14 }}" font-size="9" font-family="system-ui,sans-serif"
        fill="{% if sb.is_quarter_day %}{{ vars.text_color }}{% else %}{{ vars.ring_color }}{% endif %}"
        opacity=".75">
    {{ "%-13s" | format(sb.name) }} {{ sb.iso_date }}{% if sb.is_quarter_day %}  (quarter day){% endif %}
  </text>
  {% endfor %}
  {% endif %}

  <!-- MOON OVERLAY — same math pattern, plus loop.index for ordinal labels -->
  {% if moon %}
  <text x="450" y="945" font-size="11" font-weight="600" font-family="system-ui,sans-serif" fill="{{ vars.ring_color }}">
    Moon phases · {{ moon.year }}-{{ "%02d" | format(moon.month) }} ({{ moon.phase_events | length }} events)
  </text>
  {% for ev in moon.phase_events %}
  <text x="450" y="{{ 965 + loop.index0 * 14 }}" font-size="9" font-family="system-ui,sans-serif"
        fill="{{ vars.text_color }}" opacity=".75">
    {{ ev.glyph }} {{ ev.phase }} on {{ ev.iso_date }}
  </text>
  {% endfor %}
  {% endif %}

</svg>
