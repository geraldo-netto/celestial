<?xml version="1.0" encoding="UTF-8"?>
{# Vedic Rasi (sign) chart in North-Indian "diamond" style.
   The 12 signs are laid out in a fixed 4x4 box with the chart centered;
   planets are placed in the box of their sidereal rasi.
   Run: celestial render --chart-type rasi --date X --lat Y --lon=-Z
        --template vedic_rasi.svg.tt --out rasi.svg #}
{% set page_w = 1100 %}
{% set page_h = 900 %}
{% set bg = "#ffffff" %}
{% set ink    = "#2a1a0a" %}
{% set muted  = "#8a7060" %}
{% set accent = "#a85838" %}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1100 900" width="297mm" height="210mm" preserveAspectRatio="xMidYMid meet">
  <rect width="{{ page_w }}" height="{{ page_h }}" fill="{{ bg }}"/>

  <!-- Title -->
  <text x="{{ page_w / 2 }}" y="44" text-anchor="middle" font-size="24" font-weight="600"
        font-family="Georgia,serif" fill="{{ ink }}">Vedic Rasi Chart</text>
  <text x="{{ page_w / 2 }}" y="68" text-anchor="middle" font-size="11"
        font-family="system-ui,sans-serif" fill="{{ muted }}">{{ date_label }} · JD {{ jd | round(2) }}</text>

  {# === Diamond layout: 12 boxes arranged like North-Indian kundali === #}
  {# Boxes are positioned in 4x4 with the central 2x2 left empty.
     Sign indices in North-Indian style start with rasi 1 (Aries) at top-center
     and proceed counter-clockwise. We position each box explicitly. #}
  {% set bx = 130 %}
  {% set by = 110 %}
  {% set sz = 160 %}
  {# rasi number → (col, row) in the 4x4 grid (col 0-3, row 0-3) #}
  {# Standard North-Indian assignment: #}
  {#   row 0: [_, 12, 1, _]    (Pisces, Aries) #}
  {#   row 1: [11, _, _, 2]    (Aquarius, Taurus) #}
  {#   row 2: [10, _, _, 3]    (Capricorn, Gemini) #}
  {#   row 3: [_, 9, 4, _]     (Sagittarius, Cancer) — wait, I'll use a simpler 12-around layout #}

  {# Actually: simpler 4x3 grid showing all 12 rasis in zodiac order #}
  {% set cols = 4 %}
  {% set sign_names = ["Aries","Taurus","Gemini","Cancer","Leo","Virgo","Libra","Scorpio","Sagittarius","Capricorn","Aquarius","Pisces"] %}
  {% set sign_glyphs = ["♈","♉","♊","♋","♌","♍","♎","♏","♐","♑","♒","♓"] %}

  {% for i in range(12) %}
    {% set col = i % cols %}
    {% set row = (i - col) / cols %}
    {% set x = bx + col * sz %}
    {% set y = by + row * sz %}

    <!-- Sign box -->
    <rect x="{{ x }}" y="{{ y }}" width="{{ sz }}" height="{{ sz }}"
          fill="none" stroke="{{ muted }}" stroke-width="1"/>
    <!-- Sign label corner -->
    <text x="{{ x + 6 }}" y="{{ y + 16 }}" font-size="11" font-weight="600"
          font-family="system-ui,sans-serif" fill="{{ accent }}">{{ i + 1 }}</text>
    <text x="{{ x + sz - 6 }}" y="{{ y + 18 }}" text-anchor="end"
          font-size="14" font-family="serif" fill="{{ ink }}">{{ sign_glyphs[i] }}</text>
    <text x="{{ x + sz - 6 }}" y="{{ y + 30 }}" text-anchor="end"
          font-size="9" font-family="system-ui,sans-serif" fill="{{ muted }}">{{ sign_names[i] }}</text>

    {# Find planets whose rasi matches this sign, list them inside the box #}
    {% set planets_here = planets | selectattr("rasi", "equalto", i + 1) | list %}
    {% for p in planets_here %}
    <text x="{{ x + sz / 2 }}" y="{{ y + 60 + loop.index0 * 22 }}" text-anchor="middle"
          font-size="14" font-family="serif"
          fill="{% if p.retro %}{{ accent }}{% else %}{{ ink }}{% endif %}">
      {{ p.glyph }} {{ p.name }} {{ p.deg_in_rasi | round(0) }}°
    </text>
    <text x="{{ x + sz / 2 }}" y="{{ y + 60 + loop.index0 * 22 + 12 }}" text-anchor="middle"
          font-size="8" font-style="italic" font-family="Georgia,serif"
          fill="{{ muted }}">{{ p.nakshatra_name }} pd {{ p.pada }}</text>
    {% endfor %}
  {% endfor %}

  {# === Dasha periods table on the right === #}
  <g transform="translate(820, 110)">
    <text x="0" y="0" font-size="14" font-weight="600" font-family="Georgia,serif" fill="{{ ink }}">
      Vimshottari Dasha
    </text>
    <line x1="0" y1="6" x2="240" y2="6" stroke="{{ muted }}" stroke-width="0.5"/>
    {% for d in dashas[:9] %}
    <text x="0" y="{{ 24 + loop.index0 * 18 }}" font-size="10" font-family="serif" fill="{{ ink }}">
      {{ d.body }}
    </text>
    <text x="80" y="{{ 24 + loop.index0 * 18 }}" font-size="9"
          font-family="ui-monospace,monospace" fill="{{ muted }}">
      {{ d.years | round(2) }}y
    </text>
    {% endfor %}
  </g>

  <!-- Footer: total rasi and key ascendant info -->
  <text x="{{ page_w / 2 }}" y="{{ page_h - 30 }}" text-anchor="middle"
        font-size="10" font-family="system-ui,sans-serif" fill="{{ muted }}">
    Sidereal Moon: {{ moon_sid_lon | round(2) }}°  ·  {{ planets | length }} bodies plotted by sidereal rasi
  </text>
</svg>
