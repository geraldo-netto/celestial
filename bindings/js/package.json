{
  "name": "celestial-js",
  "version": "0.1.0",
  "description": "Swiss Ephemeris bindings for Node.js/TypeScript (via napi-rs)",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "AGPL-3.0",
  "keywords": [
    "astrology",
    "ephemeris",
    "astronomy",
    "swiss-ephemeris",
    "napi"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:dev": "napi build --platform",
    "test": "vitest run tests/celestial.test.ts tests/binding_golden.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint tests/"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@napi-rs/cli": "^2.18.0",
    "@types/node": "^20.19.39",
    "eslint": "^9",
    "prettier": "^3.8.3",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4.1.10"
  }
}
