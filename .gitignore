# ══════════════════════════════════════════════════════════════════════════════
# celestial — .gitignore
# Languages: Rust · Python · JavaScript / TypeScript
# ══════════════════════════════════════════════════════════════════════════════

# ─── Rust ─────────────────────────────────────────────────────────────────────

# Cargo build output
/target/
**/target/

# Cargo lock is committed for binaries/apps; for libraries it is optional.
# This workspace contains both — keep it committed.
# Cargo.lock  ← intentionally NOT ignored

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows-specific PDB debug symbols
*.pdb

# ─── Python ───────────────────────────────────────────────────────────────────

# Byte-compiled / optimised / DLL files
**/__pycache__/
**/*.py[cod]
**/*$py.class

# C extensions (compiled .so / .pyd)
**/*.so
**/*.pyd

# Distribution / packaging
**/.Python
**/build/
**/develop-eggs/
**/dist/
**/downloads/
**/eggs/
**/.eggs/
**/lib/
**/lib64/
**/parts/
**/sdist/
**/var/
**/wheels/
**/share/python-wheels/
**/*.egg-info/
**/.installed.cfg
**/*.egg
**/MANIFEST

# PyInstaller
**/*.manifest
**/*.spec

# Installer logs
**/pip-log.txt
**/pip-delete-this-directory.txt

# Unit test / coverage reports
**/.tox/
**/.nox/
**/.coverage
**/.coverage.*
**/.cache
**/nosetests.xml
**/coverage.xml
**/*.cover
**/*.py,cover
**/.hypothesis/
**/.pytest_cache/
**/cover/
# Rust coverage (cargo llvm-cov / tarpaulin output)
/lcov.info
**/lcov.info
**/llvm-cov-target/

# Translations
**/*.mo
**/*.pot

# Sphinx documentation
**/docs/_build/

# PyBuilder
**/.pybuilder/
**/target/

# Jupyter Notebook
**/.ipynb_checkpoints

# IPython
**/profile_default/
**/ipython_config.py

# pyenv
**/.python-version

# pipenv / poetry
# Pipfile.lock  ← commit this if you use pipenv
# poetry.lock   ← commit this if you use poetry

# PEP 582
**/__pypackages__/

# Celery
**/celerybeat-schedule
**/celerybeat.pid

# SageMath
**/*.sage.py

# Environments
**/.env
**/.venv
**/env/
**/venv/
**/ENV/
**/env.bak/
**/venv.bak/

# Spyder project settings
**/.spyderproject.db
**/.spyproject

# Rope project settings
**/.ropeproject

# mkdocs
**/site/

# mypy
**/.mypy_cache/
**/.dmypy.json
**/dmypy.json

# Pyre type checker
**/.pyre/

# pytype static type analyser
**/.pytype/

# Cython debug symbols
**/cython_debug/

# Maturin / PyO3 build artefacts
**/bindings/python/python/celestial_py/_celestial_py*.so
**/bindings/python/python/celestial_py/_celestial_py*.pyd

# ─── JavaScript / TypeScript ──────────────────────────────────────────────────

# Dependencies
**/node_modules/
**/.npm
**/.yarn/

# Build output
**/dist/
**/out/
**/.next/
**/.nuxt/
**/.cache/

# napi-rs compiled native addon (built with `npm run build`)
**/bindings/js/*.node

# TypeScript compiled output
**/*.js.map
**/*.d.ts.map
# Keep index.d.ts (hand-written declarations) — only ignore generated ones:
**/bindings/js/dist/

# Parcel cache
**/.parcel-cache/

# Vite cache
**/.vite/

# eslint cache
**/.eslintcache

# Microbundle cache
**/.rpt2_cache/
**/.rts2_cache_cjs/
**/.rts2_cache_es/
**/.rts2_cache_umd/

# Optional npm cache directory
**/.npm

# Optional REPL history
**/.node_repl_history

# Yarn integrity file
**/.yarn-integrity

# dotenv
**/.env
**/.env.test
**/.env.production

# Stores VSCode session
**/*.ntvs*
**/*.njsproj
**/*.sln
**/*.sw?

